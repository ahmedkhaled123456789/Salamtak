# Copy to .env.local (git-ignored via *.local). Placeholders only - never put secrets in VITE_* variables:
# everything prefixed VITE_ is embedded in the browser bundle.

# Base URL of the backend REST API, including the /api/v1 prefix.
#   - Local dev (default): leave as "/api/v1" and the Vite dev server proxies /api to VITE_DEV_API_TARGET.
#   - Staging / production: set the real API origin, e.g. https://api.example.com/api/v1
#     (the backend must list this site's origin in CORS_ORIGINS).
VITE_API_BASE_URL=/api/v1

# Dev server only (read by vite.config.ts, not exposed to the browser): where /api is proxied to.
VITE_DEV_API_TARGET=https://salamtak-backend-npmb.vercel.app/

# Portfolio deployment only (API runs with DEMO_MODE=true): show one-click demo accounts on the sign-in page.
# VITE_DEMO_PASSWORD is embedded in the bundle - only ever the public demo password.
VITE_PORTFOLIO_DEMO=
VITE_DEMO_PASSWORD=
